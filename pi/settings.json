{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.4.0",
  "theme": "gruvbox-dark",
  "defaultProvider": "pi-claude",
  "defaultModel": "claude-sonnet-5-5",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+codemode"],
  "packages": ["npm:pi-web-access"],
  "compaction": {
    "enabled": false
  },
  "images": {
    "blockImages": true
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "hideThinkingBlock": false,
  "foreignThinking": {
    "default": "text",
    "rules": [
      { "from": "anthropic/*", "to": "anthropic/*", "mode": "keep" },
      { "from": "pi-claude/*", "to": "anthropic/*", "mode": "keep" },
      { "from": "lmstudio/*", "to": "lmstudio/*", "mode": "keep" }
    ]
  },
  "showCacheMissNotices": true,
  "showHardwareCursor": false,
  "modelThinkingLevels": {
    "openai-codex/gpt-6-astra": "medium",
    "lmstudio/qwen/qwen3.8-27b": "medium"
  },
  "autocompleteMaxVisible": 20,
  "steeringMode": "all",
  "iHaveAdhd": {
    "alwaysOn": true
  },
  "exploreMode": {
    "alwaysOn": true
  }
}
