{
  "lastChangelogVersion": "0.84.4",
  "theme": "gruvbox-dark",
  "defaultProvider": "pi-claude",
  "defaultModel": "claude-fable-5-1",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-web-access",
    "npm:@vanillagreen/pi-claude-bridge",
    "npm:@firstpick/pi-themes-bundle",
    "npm:@burneikis/pi-vim"
  ],
  "compaction": {
    "enabled": false
  },
  "images": {
    "blockImages": true
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "hideThinkingBlock": false,
  "showCacheMissNotices": false,
  "showHardwareCursor": false
}