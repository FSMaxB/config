{
  "name": "pi-sandbox",
  "private": true,
  "description": "Overrides pi's bash tool with one that runs inside @anthropic-ai/sandbox-runtime, loaded from source as a pi directory extension.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test src/*.test.ts",
    "test:int": "SANDBOX_INTEGRATION=1 node --test src/integration.test.ts src/escape.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^24.3.0",
    "typescript": "^6.0.3"
  }
}
